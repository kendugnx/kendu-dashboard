{
"rewrites": [{ "source": "/((?!@|src|node_modules|assets|fonts|api|public|.*\\.mp4|.*\\.gif|.*\\.jpg|.*\\.jpeg|.*\\.png|.*\\.svg|.*\\.webp|.*\\.ico|.*\\.webmanifest|.*\\.js).*)", "destination": "/index.html" }],
  "functions": {
    "api/snapshot-image.js": { "memory": 1536, "maxDuration": 30 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
